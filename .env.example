LEGALFEDLLM_BOOTSTRAP_ROLE=development
# All-in-one development template. Real split deployments use the tracked host/client role templates.
COORDINATOR_PORT=8000
CLIENT_PORT=8001
HOST_RUNTIME_URL=http://host:8002
COORDINATOR_URL=http://coordinator:8000

COORDINATOR_ID=legalfedllm-coordinator
HOST_ID=legalfedllm-host
CLIENT_ID=legal-client-1

ADMIN_TOKEN=placeholder-admin-token
# Development-only one-time enrollment seed; real split Host deployments issue tokens through the Coordinator admin API.
REGISTRATION_TOKEN=placeholder-registration-token
INTERNAL_API_TOKEN=placeholder-internal-token
CLIENT_ADMIN_TOKEN=placeholder-client-admin-token
HF_TOKEN=
MAXIMUM_CLOCK_SKEW_SECONDS=900
ROUND_MONITOR_INTERVAL_SECONDS=2
COORDINATOR_QUORUM_POLICY=majority
COORDINATOR_MINIMUM_TRUSTED_CLIENT_QUORUM=2
# Temporary one-Client development override. Remove it before multi-Client tests.
COORDINATOR_TRUSTED_CLIENT_QUORUM_OVERRIDE=
COORDINATOR_DATASET_DIR=./data/derived/gld2012
COORDINATOR_REFERENCE_DATASET_PATH=
COORDINATOR_VALIDATION_DATASET_PATH=
# Real DTW rounds require the mounted snapshots:
# COORDINATOR_REFERENCE_DATASET_PATH=/datasets/reference.jsonl
# COORDINATOR_VALIDATION_DATASET_PATH=/datasets/validation.jsonl

HOST_MODEL_PROFILE=mock
HOST_TRAINING_BACKEND=mock
HOST_MODEL_ID=legalfedllm/host
HOST_SERVING_BACKEND=ollama
HOST_OLLAMA_MODEL=granite3.3:2b
HOST_MAXIMUM_TRAINING_JOB_BYTES=536870912

# compose.host-ml.yaml real-Host training and inference defaults:
# HOST_MODEL_PROFILE=granite-3.3-2b-instruct-host-lora-v1
# HOST_TRAINING_DEVICE=cuda
# HOST_TRAINING_PRECISION=bfloat16
# HOST_PUBLIC_DATA_EPOCHS=5
# HOST_MICRO_BATCH_SIZE=1
# HOST_KNOWLEDGE_BATCH_SIZE=1
# HOST_GRADIENT_ACCUMULATION_STEPS=4
# HOST_LEARNING_RATE=3e-5
# HOST_WARMUP_RATIO=0.008
# HOST_DATALOADER_NUM_WORKERS=4
# HOST_TRAINING_SEED=42
# HOST_GRADIENT_CHECKPOINTING=false
# HOST_VERIFY_FROZEN_BASE_CHECKSUM=true

# Mistral Nemo smoke profile (direct venv; compose remains Granite):
# HOST_MODEL_PROFILE=mistral-nemo-instruct-2407-host-lora-v1
# HOST_TRAINING_BACKEND=transformers
# HOST_SERVING_BACKEND=mock
# HOST_DATA_DIR=/scratch/legalfedllm-test/artifacts/nemo-host-smoke-import
# HOST_TRAINING_DEVICE=cuda
# HOST_TRAINING_PRECISION=bfloat16
# HOST_PUBLIC_DATA_EPOCHS=1
# HOST_MICRO_BATCH_SIZE=1
# HOST_GRADIENT_ACCUMULATION_STEPS=1
# HOST_LEARNING_RATE=3e-5
# HOST_WARMUP_RATIO=0
# HOST_DATALOADER_NUM_WORKERS=0
# HOST_GRADIENT_CHECKPOINTING=true
# HOST_VERIFY_FROZEN_BASE_CHECKSUM=true

CLIENT_TRAINING_BACKEND=transformers
CLIENT_MODEL_ID=legalfedllm/client
CLIENT_SERVING_BACKEND=ollama
CLIENT_OLLAMA_MODEL=qwen3:1.7b

# compose.yaml real-Client defaults:
# CLIENT_MODEL_PROFILE=qwen3-1.7b-lora-v1
# CLIENT_TRAINING_DEVICE=cuda
# CLIENT_TRAINING_PRECISION=bfloat16
# CLIENT_PRIVATE_DATA_DIR=./data/client-private
# CLIENT_PRIVATE_DATASET_ID=client-private-v1
# CLIENT_MICRO_BATCH_SIZE=1
# CLIENT_GRADIENT_ACCUMULATION_STEPS=8
# CLIENT_LEARNING_RATE=2e-4
# CLIENT_TRAINING_SEED=42
# CLIENT_GRADIENT_CHECKPOINTING=false
# CLIENT_VERIFY_FROZEN_BASE_CHECKSUM=false
# CLIENT_KNOWLEDGE_BATCH_SIZE=1
# CLIENT_SAFEFED_PROBE_DIR=./data/client-safety-probe
# CLIENT_SAFEFED_PROBE_MANIFEST_PATH=/safety-probe/probe.json
# CLIENT_FORCE_REVERSE_VALIDATION_FAILURE=false

# Standalone split-topology Client image and slots. Use config/clients.env.example
# with compose.clients.yaml for the actual Host-container/local-Client workflow.
CLIENT_IMAGE=legalfedllm-client-dev:latest
QWEN_CLIENT_ID=legal-client-1
QWEN_CLIENT_PORT=8001
QWEN_CLIENT_MODEL_PROFILE=qwen3-1.7b-lora-v1
QWEN_CLIENT_MODEL_ID=legalfedllm/client-qwen
QWEN_CLIENT_SERVING_BACKEND=ollama
QWEN_CLIENT_OLLAMA_MODEL=qwen3:1.7b
QWEN_CLIENT_PRIVATE_DATA_DIR=./data/client-private-qwen
QWEN_CLIENT_PRIVATE_DATASET_ID=qwen-client-private-v1
QWEN_CLIENT_ADMIN_TOKEN=placeholder-qwen-client-admin-token
QWEN_CLIENT_SAFEFED_PROBE_DIR=./data/client-safety-probe
QWEN_CLIENT_URL=http://127.0.0.1:8001

GRANITE_CLIENT_ID=legal-client-2
GRANITE_CLIENT_PORT=8002
GRANITE_CLIENT_MODEL_PROFILE=granite-3.3-2b-instruct-client-lora-v1
GRANITE_CLIENT_MODEL_ID=legalfedllm/client-granite
GRANITE_CLIENT_SERVING_BACKEND=ollama
GRANITE_CLIENT_OLLAMA_MODEL=granite3.3:2b
GRANITE_CLIENT_PRIVATE_DATA_DIR=./data/client-private-granite
GRANITE_CLIENT_PRIVATE_DATASET_ID=granite-client-private-v1
GRANITE_CLIENT_ADMIN_TOKEN=placeholder-granite-client-admin-token
GRANITE_CLIENT_URL=http://127.0.0.1:8002

ROUND_COORDINATOR_URL=http://127.0.0.1:8000
ROUND_CLIENT_SLOTS=client-1
ROUND_TOP_K=4
ROUND_MAXIMUM_SEQUENCE_LENGTH=4096
ROUND_PRIVATE_TRAINING_EPOCHS=1
ROUND_HOST_PUBLIC_DATA_EPOCHS=5
ROUND_SUBMISSION_WINDOW_SECONDS=21600
ROUND_TIMEOUT_SECONDS=21600
ROUND_POLL_INTERVAL_SECONDS=5

# Windows Docker Desktop with native Ollama:
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Bazzite/Podman with host Ollama:
# OLLAMA_BASE_URL=http://host.containers.internal:11434

HOST_TIMEOUT_SECONDS=21600
COORDINATOR_TIMEOUT_SECONDS=60
COORDINATOR_RECONCILIATION_TIMEOUT_SECONDS=30
COORDINATOR_RECONCILIATION_POLL_SECONDS=1
