COORDINATOR_PORT=8000
CLIENT_PORT=8001

COORDINATOR_ID=legalfedllm-coordinator
HOST_ID=legalfedllm-host
CLIENT_ID=legal-client-1

ADMIN_TOKEN=placeholder-admin-token
REGISTRATION_TOKEN=placeholder-registration-token
INTERNAL_API_TOKEN=placeholder-internal-token
CLIENT_ADMIN_TOKEN=placeholder-client-admin-token
MAXIMUM_CLOCK_SKEW_SECONDS=900
ROUND_MONITOR_INTERVAL_SECONDS=2

HOST_TRAINING_BACKEND=
HOST_MODEL_ID=legalfedllm/host
HOST_SERVING_BACKEND=ollama
HOST_OLLAMA_MODEL=granite3.3:2b

CLIENT_TRAINING_BACKEND=transformers
CLIENT_MODEL_ID=legalfedllm/client
CLIENT_SERVING_BACKEND=ollama
CLIENT_OLLAMA_MODEL=qwen3:1.7b

# compose.yaml real-Client defaults:
# CLIENT_MODEL_PROFILE=qwen3-1.7b-lora-v1
# CLIENT_TRAINING_DEVICE=cuda
# CLIENT_TRAINING_PRECISION=bfloat16
# CLIENT_PRIVATE_DATA_DIR=./data/client-private
# CLIENT_PRIVATE_DATASET_ID=client-private-v1
# CLIENT_MICRO_BATCH_SIZE=1
# CLIENT_GRADIENT_ACCUMULATION_STEPS=8
# CLIENT_LEARNING_RATE=2e-4
# CLIENT_TRAINING_SEED=42
# CLIENT_GRADIENT_CHECKPOINTING=false
# CLIENT_VERIFY_FROZEN_BASE_CHECKSUM=false
# CLIENT_KNOWLEDGE_BATCH_SIZE=1

# Windows Docker Desktop with native Ollama:
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Bazzite/Podman with host Ollama:
# OLLAMA_BASE_URL=http://host.containers.internal:11434

HOST_TIMEOUT_SECONDS=60
COORDINATOR_TIMEOUT_SECONDS=60
