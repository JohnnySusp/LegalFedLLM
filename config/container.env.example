LEGALFEDLLM_BOOTSTRAP_ROLE=host
LEGALFEDLLM_RUNTIME_ROOT=/scratch/legalfedllm-test
PYTHONPATH=.

HF_HOME=/scratch/legalfedllm-test/cache/huggingface
PIP_CACHE_DIR=/scratch/legalfedllm-test/cache/pip
TORCH_HOME=/scratch/legalfedllm-test/cache/torch
TORCH_EXTENSIONS_DIR=/scratch/legalfedllm-test/cache/torch-extensions
TRITON_HOME=/scratch/legalfedllm-test/cache/triton
XDG_CACHE_HOME=/scratch/legalfedllm-test/cache/xdg
CUDA_CACHE_PATH=/scratch/legalfedllm-test/cache/cuda
TMPDIR=/scratch/legalfedllm-test/tmp
TOKENIZERS_PARALLELISM=false
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

HOST_BIND_HOST=127.0.0.1
HOST_PORT=8002
HOST_DATA_DIR=/scratch/legalfedllm-test/artifacts/host-runtime
HOST_ID=legalfedllm-host
HOST_MODEL_PROFILE=mistral-nemo-instruct-2407-host-lora-v1
HOST_TRAINING_BACKEND=transformers
HOST_SERVING_BACKEND=transformers
HOST_TRAINING_DEVICE=cuda
HOST_TRAINING_PRECISION=bfloat16
HOST_PUBLIC_DATA_EPOCHS=5
HOST_MICRO_BATCH_SIZE=1
HOST_KNOWLEDGE_BATCH_SIZE=1
HOST_GRADIENT_ACCUMULATION_STEPS=4
HOST_LEARNING_RATE=3e-5
HOST_WARMUP_RATIO=0.008
HOST_DATALOADER_NUM_WORKERS=0
HOST_TRAINING_SEED=42
HOST_GRADIENT_CHECKPOINTING=true
HOST_VERIFY_FROZEN_BASE_CHECKSUM=true
HOST_MAXIMUM_TRAINING_JOB_BYTES=536870912
HOST_STARTUP_TIMEOUT_SECONDS=900
HOST_TIMEOUT_SECONDS=21600
HOST_INFERENCE_QUEUE_MAXIMUM=4
HOST_INFERENCE_QUEUE_TIMEOUT_SECONDS=60

COORDINATOR_BIND_HOST=127.0.0.1
COORDINATOR_PORT=8000
COORDINATOR_DATA_DIR=/scratch/legalfedllm-test/artifacts/coordinator-runtime
COORDINATOR_ID=legalfedllm-coordinator
HOST_RUNTIME_URL=http://127.0.0.1:8002
COORDINATOR_REFERENCE_DATASET_PATH=/scratch/legalfedllm-test/datasets/gld2012/reference.jsonl
COORDINATOR_VALIDATION_DATASET_PATH=/scratch/legalfedllm-test/datasets/gld2012/validation.jsonl
COORDINATOR_QUORUM_POLICY=majority
COORDINATOR_MINIMUM_TRUSTED_CLIENT_QUORUM=2
COORDINATOR_TRUSTED_CLIENT_QUORUM_OVERRIDE=
ROUND_MONITOR_INTERVAL_SECONDS=2
MAXIMUM_CLOCK_SKEW_SECONDS=900

ADMIN_TOKEN=
INTERNAL_API_TOKEN=

QWEN_CLIENT_ID=legal-client-1
GRANITE_CLIENT_ID=legal-client-2
ROUND_CLIENT_SLOTS=client-1
ROUND_TOP_K=4
ROUND_MAXIMUM_SEQUENCE_LENGTH=4096
ROUND_PRIVATE_TRAINING_EPOCHS=1
ROUND_HOST_PUBLIC_DATA_EPOCHS=5
ROUND_SUBMISSION_WINDOW_SECONDS=21600
ROUND_TIMEOUT_SECONDS=21600
ROUND_POLL_INTERVAL_SECONDS=5
